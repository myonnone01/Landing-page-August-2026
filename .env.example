# Copy to .env and fill in. .env is gitignored — never commit real values.
# The database schema applies itself on first use; there is no migration to run.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Postgres connection string. Get it from the Neon console:
#   https://console.neon.tech -> your project -> Connection Details -> "Connection string"
# Use the POOLED connection string (host contains "-pooler") for serverless.
# Keep a separate Neon branch for local dev so test rows never land in the real roster.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Admin roster gate (required)
# ---------------------------------------------------------------------------
# Passcode for /admin. Anyone with this string sees every registrant's contact
# details. Set it in Vercel's env settings, not here, for production.
# Deliberately left blank — the real passcode must never be committed.
ADMIN_PASSCODE=""

# Signing key for the admin session cookie. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs out anyone currently signed in to /admin.
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Capacity (optional — defaults to 50)
# ---------------------------------------------------------------------------
# Total seats on the Middlebank, counting hosts. Drives "spots left", the
# waitlist switch, and the admin header stats. Counts people, not registrations.
# A missing or invalid value falls back to 50 and logs, rather than breaking
# the page.
EVENT_CAPACITY="50"
